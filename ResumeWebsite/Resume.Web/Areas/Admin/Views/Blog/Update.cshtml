@using Resume.DAL.ViewModels.Blog
@model EditBlogViewModel

@{
    ViewData["Title"] = "ویرایش مطلب";
}

<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card">
            <div class="header">
                <h2>
                    @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <form asp-action="Update" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="ID" />
                    <div class="row clearfix">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <div class="form-line">
                                    <input type="text" asp-for="Title" class="form-control" placeholder="عنوان">
                                    <span class="text-danger" asp-validation-for="Title"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <div class="form-line">
                                    <input type="text" asp-for="BlogDate" class="form-control" placeholder="تاریخ پروژه (اختیاری)">
                                    <span class="text-danger" asp-validation-for="BlogDate"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <div class="form-line">
                                    <textarea asp-for="ShortText" class="form-control" rows="5" placeholder="متن کوتاه"></textarea>
                                    <span class="text-danger" asp-validation-for="ShortText"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <div class="form-line">
                                    <textarea asp-for="LongText" class="form-control" placeholder="متن بلند"></textarea>
                                    <span class="text-danger" asp-validation-for="LongText"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <div class="form-line">
                                    <input type="file" asp-for="Avatar" class="form-control" placeholder="انتخاب تصویر">
                                    <span class="text-danger" asp-validation-for="Avatar"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <button type="submit" class="btn btn-warning btn-lg m-l-15 waves-effect">ویرایش</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="https://cdn.ckeditor.com/4.9.2/standard/ckeditor.js"></script>
    <script>

        CKEDITOR.replace('LongText', {
            customConfig: '/Admin/assets/js/Config.js'
        });

    </script>
}