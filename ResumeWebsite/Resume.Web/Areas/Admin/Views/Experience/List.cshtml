@using Resume.Bussines.Extentions
@using Resume.DAL.ViewModels.Experience
@model FilterExperienceViewModel

@{
    ViewData["Title"] = "لیست تجربه های کاری";
}

<div class="block-header">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
            <ul class="breadcrumb breadcrumb-style ">
                <li class="breadcrumb-item">
                    <h4 class="page-title">@ViewData["Title"]</h4>
                </li>
                <li class="breadcrumb-item bcrumb-1">
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-home"></i> داشبورد
                    </a>
                </li>
                <li class="breadcrumb-item bcrumb-2">
                    <a href="#" onClick="return false;">مدیریت تجربه های کاری من</a>
                </li>
                <li class="breadcrumb-item active"> @ViewData["Title"]</li>
            </ul>
        </div>
    </div>
</div>
<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-4">
        <div class="card">
            <div class="header">
                <h2>
                    فیلترها
                </h2>
            </div>
            <div class="body">
                <form method="get" asp-action="List" id="filter-search">
                    <input type="hidden" asp-for="Page" />
                    <div class="row clearfix">
                        <div class="col-sm-12 col-md-4">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <input type="text" class="form-control" asp-for="Title">
                                    <label class="form-label" asp-for="Title"></label>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-4">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <input type="date" class="form-control" asp-for="StartDate">
                                    <label class="form-label" asp-for="StartDate"></label>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-4">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <input type="date" class="form-control" asp-for="EndDate">
                                    <label class="form-label" asp-for="EndDate"></label>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <button class="btn btn-info">جستجو</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card">
            <div class="header">
                <h2>
                    @ViewData["Title"]
                    <a style="float:left" asp-action="Create" asp-controller="Experience" asp-area="Admin" class="btn btn-success">افزودن تجربه کاری</a>
                </h2>
            </div>
            <div class="body table-responsive">
                @if (Model != null && Model.Entities != null && Model.Entities.Any())
                {
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>شناسه</th>
                                <th>عنوان</th>
                                <th>از تاریخ</th>
                                <th>تا تاریخ</th>
                                <th>تاریخ ایجاد</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var experience in Model.Entities)
                            {
                                <tr>
                                    <th scope="row">@experience.ID</th>
                                    <td>@experience.Title</td>
                                    <td>@experience.StartDate</td>
                                    <td>
                                        @if (experience.EndDate.HasValue)
                                        {
                                            <text>@experience.EndDate</text>
                                        }
                                        else
                                        {
                                            <text>---</text>
                                        }
                                    </td>
                                    <td>@experience.CreateDate.ToShamsi()</td>
                                    <td>
                                        <a asp-action="Update" asp-route-id="@experience.ID" class="text-warning">
                                            <i class="fa fa-pen"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@experience.ID" class="text-warning">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <partial name="_AdminPagination" model="@Model.GetCurrentPaging()" />
                }
                else
                {
                    <partial name="_AdminNotFound" />
                }

            </div>
        </div>
    </div>
</div>