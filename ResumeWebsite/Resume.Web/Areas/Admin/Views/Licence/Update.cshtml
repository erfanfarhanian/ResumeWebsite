@using Resume.DAL.ViewModels.Licence
@model EditLicenceViewModel

@{
    ViewData["Title"] = "ویرایش گواهینامه";
}

<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card">
            <div class="header">
                <h2>
                    @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <form asp-action="Update" method="post">
                    <input type="hidden" asp-for="ID" />
                    <div class="row clearfix">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <div class="form-line">
                                    <input type="text" asp-for="Title" class="form-control" placeholder="عنوان">
                                    <span class="text-danger" asp-validation-for="Title"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <div class="form-line">
                                    <input type="text" asp-for="Institute" class="form-control" placeholder="نام موسسه یا آموزشگاه">
                                    <span class="text-danger" asp-validation-for="Institute"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <div class="form-line">
                                    <textarea asp-for="IssueDate" class="form-control" placeholder="تاریخ صدور"></textarea>
                                    <span class="text-danger" asp-validation-for="IssueDate"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <button type="submit" class="btn btn-warning btn-lg m-l-15 waves-effect">ویرایش</button>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>