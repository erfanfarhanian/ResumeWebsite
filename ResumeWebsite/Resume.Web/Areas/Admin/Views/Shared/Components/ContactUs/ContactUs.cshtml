@using Resume.Bussines.Extentions
@using Resume.DAL.ViewModels.ContactUs
@model FilterContactUsViewModel

<div class="header">
    <h2>
        @ViewData["Title"]
    </h2>
</div>
<div class="body table-responsive">
    <h5>لیست تماس با من</h5>
    <br />
    @if (Model != null && Model.Entities != null && Model.Entities.Any())
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>نام</th>
                    <th>نام خانوادگی</th>
                    <th>شماره تماس</th>
                    <th>ایمیل</th>
                    <th>عنوان</th>
                    <th>تاریخ ثبت</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Entities)
                {
                    <tr>
                        <td>@item.FirstName</td>
                        <td>@item.LastName</td>
                        <td>@item.Mobile</td>
                        <td>@item.Email</td>
                        <td>@item.Title</td>
                        <td>@item.CreateDate.ToShamsi()</td>
                        <td>
                            <a asp-controller="ContactUs" asp-action="Details" asp-route-id="@item.ContactUsID" class="text-info">
                                <i class="fa fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <partial name="_AdminPagination" model="@Model.GetCurrentPaging()" />
    }
    else
    {
        <partial name="_AdminNotFound" />
    }

</div>