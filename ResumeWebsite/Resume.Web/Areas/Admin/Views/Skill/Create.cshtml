@using Resume.DAL.ViewModels.Skill
@model CreateSkillViewModel

@{
    ViewData["Title"] = "افزودن مهارت";
}

<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card">
            <div class="header">
                <h2>
                    @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <form asp-action="Create" method="post">
                    <div class="row clearfix">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <div class="form-line">
                                    <input type="text" asp-for="Title" class="form-control" placeholder="عنوان">
                                    <span class="text-danger" asp-validation-for="Title"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <div class="form-line">
                                    <input type="text" asp-for="Proficiency" class="form-control" placeholder="میزان مهارت (درصد)">
                                    <span class="text-danger" asp-validation-for="Proficiency"></span>
                                    <p>* لطفا مقدار را به درصد وارد نمایید.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <button type="submit" class="btn btn-success btn-lg m-l-15 waves-effect">ثبت</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>