@using Resume.DAL.ViewModels.Skill
@model DeleteSkillViewModel

@{
    ViewData["Title"] = "حذف مهارت";
}

<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card">
            <div class="header">
                <h2>
                    @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="ID" />
                    <div class="row clearfix">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <div class="form-line">
                                    <input type="text" asp-for="Title" class="form-control" placeholder="عنوان" readonly>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <div class="form-line">
                                    <input type="text" asp-for="Proficiency" class="form-control" placeholder="میزان مهارت (درصد)" readonly>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <button type="submit" class="btn btn-danger btn-lg m-l-15 waves-effect">حذف</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>