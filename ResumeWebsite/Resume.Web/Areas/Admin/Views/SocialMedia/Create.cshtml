@using Resume.DAL.ViewModels.SocialMedia
@model CreateSocialMediaViewModel

@{
    ViewData["Title"] = "افزودن شبکه اجتماعی";
}

<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card">
            <div class="header">
                <h2>
                    @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <form asp-action="Create" method="post">
                    <div class="row clearfix">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <div class="form-line">
                                    <input type="text" asp-for="Title" class="form-control" placeholder="عنوان">
                                    <span class="text-danger" asp-validation-for="Title"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <div class="form-line">
                                    <input type="text" asp-for="Url" class="form-control" placeholder="آدرس اینترنتی">
                                    <span class="text-danger" asp-validation-for="Url"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <div class="form-line">
                                    <input type="text" asp-for="Icon" class="form-control" placeholder="آیکون">
                                    <span class="text-danger" asp-validation-for="Icon"></span>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="simple-line-icon-container row">
                                    <div class="col-sm-6 col-md-4 col-lg-3">
                                        <i class="ti-instagram"></i> font-icon icon-instagram1
                                    </div>
                                    <div class="col-sm-6 col-md-4 col-lg-3"> <i class="ti-github"></i> font-icon icon-github1 </div>
                                    <div class="col-sm-6 col-md-4 col-lg-3"> <i class="ti-facebook"></i> font-icon icon-facebook1 </div>
                                    <div class="col-sm-6 col-md-4 col-lg-3"> <i class="ti-skype"></i> font-icon icon-skype </div>
                                    <div class="col-sm-6 col-md-4 col-lg-3"> <i class="ti-youtube"></i> ti-font-icon icon-youtube1 </div>
                                    <div class="col-sm-6 col-md-4 col-lg-3"> <i class="ti-twitter"></i> font-icon icon-twitter1 </div>
                                    <div class="col-sm-6 col-md-4 col-lg-3"> <i class="ti-linkedin"></i> font-icon icon-linkedin1 </div>
                                </div>
                                <p class="text text-danger">* لطفا خارج از آیکون های بالا چیز دیگری وارد نکنید، در غیر این صورت آیکونی نمایش داده نخواهد شد.</p>
                            </div>
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <button type="submit" class="btn btn-success btn-lg m-l-15 waves-effect">ثبت</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>