@using Resume.DAL.ViewModels.User
@model FilterUserViewModel

@{
    ViewData["Title"] = "لیست کاربران";
}

<div class="block-header">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
            <ul class="breadcrumb breadcrumb-style ">
                <li class="breadcrumb-item">
                    <h4 class="page-title">@ViewData["Title"]</h4>
                </li>
                <li class="breadcrumb-item bcrumb-1">
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-home"></i> داشبورد
                    </a>
                </li>
                <li class="breadcrumb-item bcrumb-2">
                    <a href="#" onClick="return false;">مدیریت کاربران</a>
                </li>
                <li class="breadcrumb-item active"> @ViewData["Title"]</li>
            </ul>
        </div>
    </div>
</div>
<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mb-4">
        <div class="card">
            <div class="header">
                <h2>
                    فیلترها
                </h2>
            </div>
            <div class="body">
                <form method="get" asp-action="List" id="filter-search">
                    <h2 class="card-inside-title">فیلتر کاربران</h2>
                    <input type="hidden" asp-for="Page" />
                    <div class="row clearfix">
                        <div class="col-sm-12 col-md-4">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <input type="text" class="form-control" asp-for="Mobile">
                                    <label class="form-label" asp-for="Mobile"></label>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-4">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <input type="text" class="form-control" asp-for="Email">
                                    <label class="form-label" asp-for="Email"></label>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <button class="btn btn-info">جستجو</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card">
            <div class="header">
                <h2>
                    @ViewData["Title"]
                    <a style="float:left" asp-action="Create" asp-controller="User" asp-area="Admin" class="btn btn-success">افزودن کاربر</a>
                </h2>
            </div>
            <div class="body table-responsive">
                @if (Model != null && Model.Entities != null && Model.Entities.Any())
                {
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>شناسه</th>
                                <th>نام</th>
                                <th>نام خانوادگی</th>
                                <th>شماره تماس</th>
                                <th>ایمیل</th>
                                <th>وضعیت</th>
                                <th>تاریخ ثبت نام</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Entities)
                            {
                                <tr>
                                    <th scope="row">@user.ID</th>
                                    <td>@user.FirstName</td>
                                    <td>@user.LastName</td>
                                    <td>@user.Mobile</td>
                                    <td>@user.Email</td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <div class="badge col-green">فعال</div>
                                        }
                                        else
                                        {
                                            <div class="badge col-red">غیر فعال</div>
                                        }
                                    </td>
                                    <td>@user.CreateDate</td>
                                    <td>
                                        <a asp-action="Update" asp-route-id="@user.ID" class="text-warning">
                                            <i class="fa fa-pen"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <partial name="_AdminPagination" model="@Model.GetCurrentPaging()" />
                }
                else
                {
                    <partial name="_AdminNotFound" />
                }

            </div>
        </div>
    </div>
</div>