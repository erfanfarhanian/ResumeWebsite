@using Resume.DAL.ViewModels.Blog
@model FilterBlogViewModel

@{
    ViewData["Title"] = "وبلاگ";
}

<!-- Content -->
<div class="col-12 col-md-12 col-lg-12">
    <div class="box box-content">
        <div class="pb-2">
            <h1 class="title title--h1 first-title title__separate">بلاگ</h1>
        </div>
        <div class="news-grid">
            @if (Model != null && Model.Entities.Any())
            {
                @foreach (var blog in Model.Entities)
                {
                    <article class="news-item box">
                        <div class="news-item__image-wrap overlay overlay--45">
                            <div class="news-item__date"><span>@blog.BlogDate</span></div>
                            <a class="news-item__link" asp-action="ShowBlog" asp-route-id="@blog.ID"></a>
                            <img class="cover lazyload" src="/Img/blog/@blog.ImageUrl" alt="@blog.Title" />
                        </div>
                        <div class="news-item__caption">
                            <h2 class="title title--h4" align="center">@blog.Title</h2>
                            <p align="justify">@blog.ShortText</p>
                        </div>
                    </article>
                }
            }
        </div>
    </div>
</div>