@using Resume.DAL.ViewModels.Portfolio
@model FilterPortfolioViewModel

@{
    ViewData["Title"] = "پروژه ها";
}

<!-- Content -->
<div class="col-12 col-md-12 col-lg-12">
    <div class="box box-content">
        <div class="pb-2">
            <h1 class="title title--h1 first-title title__separate">پروژه ها</h1>
        </div>
        <div class="news-grid">
            @if (Model != null && Model.Entities.Any())
            {
                @foreach (var portfolio in Model.Entities)
                {
                    <article class="news-item box">
                        <div class="news-item__image-wrap overlay overlay--45">
                            <div class="news-item__date"><span>@portfolio.ProjectDate</span></div>
                            <a class="news-item__link" asp-action="ShowPortfolio" asp-route-id="@portfolio.ID"></a>
                            <img class="cover lazyload" src="/Img/Portfolio/@portfolio.ImageUrl" alt="@portfolio.Title" />
                        </div>
                        <div class="news-item__caption">
                            <h2 class="title title--h4">@portfolio.Title</h2>
                            <p></p>
                        </div>
                    </article>
                }
            }
        </div>
    </div>
</div>