<!DOCTYPE html>
<html lang="fa">
<head>
    <partial name="_MetaTags" />

    <title>عرفان فرهانیان | @ViewData["Title"]</title>

    <partial name="_HeaderReferences" />

</head>
<body>
    <!-- Preloader -->
    <partial name="_Loader" />

    <main class="main">
        <!-- Header Image -->
        <partial name="_TopHeader" />

        <div class="container gutter-top">
            <!-- Header -->
            @if (ViewData["ShowHeader"] is bool show && show)
            {
                @await Component.InvokeAsync("Header")
            }

            <div class="row sticky-parent">
                <!-- Sidebar nav -->
                <partial name="_Sidebar" />

                <!-- Content -->
                <div class="col-12 col-md-12 col-lg-10">

                    @RenderBody()

                    <!-- Footer -->
                    <partial name="_Footer" />

                </div>
            </div>
        </div>
    </main>
@*     <partial name="_SiteTools" /> *@

    <partial name="_FooterReferences" />
</body>
</html>