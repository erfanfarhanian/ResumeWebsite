<aside class="col-12 col-md-12 col-lg-2">
    <div class="sidebar box sticky-column">
        <ul class="nav">
            <li class="nav__item">
                <a asp-controller="AboutMe" asp-action="Index"><i class="icon-user"></i>درباره ی من</a>
            </li>
            <li class="nav__item">
                <a asp-area="" asp-controller="Resume" asp-action="Index"><i class="icon-file-text"></i>رزومه</a>
            </li>
            <li class="nav__item">
                <a asp-controller="Portfolio" asp-action="Index"><i class="icon-codesandbox"></i> پروژه ها</a>
            </li>
            <li class="nav__item">
